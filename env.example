# Backend Configuration
JWT_SECRET=your-secret-key-change-in-production
NODE_ENV=development
PORT=8080
FRONTEND_URL=http://localhost:3000
SERVICE_NAME=digital-step-flow-backend

# Postgres (used by backend; Docker Compose sets POSTGRES_HOST=postgres)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=digitalstepflow
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Redis (used by backend; Docker Compose sets REDIS_HOST=redis)
REDIS_HOST=localhost
REDIS_PORT=6379

# Grafana (Docker Compose only)
GRAFANA_ADMIN_PASSWORD=admin

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8080/api

# Docker Hub (for CI/CD)
DOCKER_HUB_USERNAME=your-dockerhub-username
DOCKER_HUB_PASSWORD=your-dockerhub-password

